#======================================================================================
#
# 1. Applications (minimal set)
#
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-dockerman=y
# end of 1. Applications
 
#
# 2. Themes (default OpenWrt theme, no extra theme package needed)
#
# end of 2. Themes
 
#
# 3. Translate (Chinese kept, matching original selections)
#
# CONFIG_PACKAGE_luci-i18n-base-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-firewall-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn is not set
# end of 3. Translate
 
#
# 4. Other Configuration
#
CONFIG_BUSYBOX_DEFAULT_FALLOCATE=y
# end of 4. Other Configuration
